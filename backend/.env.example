# Flask Settings
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000
FLASK_DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (MySQL via PyMySQL)
DB_USER=root
DB_PASSWORD=projects
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mentor_mentee_db

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Optional for development; logs safely if unconfigured)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_DEFAULT_SENDER=no-reply@mentormentee.org
